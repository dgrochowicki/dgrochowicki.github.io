---
import '../styles/global.css';
import { site } from '../data/site';
import { href, asset, ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** ścieżka tej samej strony w drugim języku (bez prefiksu /en) */
  alt: string;
  active?: 'portfolio' | 'about';
}
const { lang, title, description, alt, active } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${t.role}`;
const aboutPath = lang === 'pl' ? 'o-mnie' : 'about';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <link rel="alternate" hreflang={other} href={href(alt, other)} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={href('', lang)}>
          <svg class="logo" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1C11.8451 1 15 4.06746 15 7.97559C14.9998 11.8836 11.845 15 8 15H1V1H8ZM3.02148 2.97852V12.9717H8C10.7605 12.9717 12.9793 10.7458 12.9795 7.97559C12.9795 5.20527 10.7606 2.97852 8 2.97852H3.02148ZM8.0498 4.94434C9.72594 4.94434 11.0566 6.27618 11.0566 7.95215C11.0564 9.6279 9.72578 10.959 8.0498 10.959H5.04297V7.95215H7.01465V8.9375H8.00098C8.54291 8.93728 8.98607 8.49403 8.98633 7.95215C8.98633 7.41006 8.54307 6.96604 8.00098 6.96582H4.99316V4.94434H8.0498Z"/></svg>
          <strong>{site.name}</strong>
        </a>
        <nav aria-label="Menu">
          <a href={href('portfolio', lang)} aria-current={active === 'portfolio' ? 'page' : undefined}>{t.navPortfolio}</a>
          <a href={href(aboutPath, lang)} aria-current={active === 'about' ? 'page' : undefined}>{t.navAbout}</a>
          <a href={asset(site.cv[lang])} target="_blank" rel="noopener" class="hide-sm">{t.navCv}</a>
          <a class="lang" href={href(alt, other)} hreflang={other} title={t.otherLangLabel}>{t.otherLang}</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <strong>{site.name}</strong>
          <div class="muted">{t.role} · Szczecin</div>
        </div>
        <div class="links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
          <a href={asset(site.cv[lang])} target="_blank" rel="noopener">{t.navCv}</a>
        </div>
      </div>
    </footer>

    <dialog id="lightbox" aria-label="Podgląd obrazu">
      <button class="lb-close" aria-label={t.close}>×</button>
      <button class="lb-nav lb-prev" aria-label={t.prev}>‹</button>
      <img alt="" />
      <button class="lb-nav lb-next" aria-label={t.next}>›</button>
      <p class="lb-cap"></p>
    </dialog>

    <script>
      const dlg = document.getElementById('lightbox') as HTMLDialogElement;
      const im = dlg.querySelector('img')!;
      const cap = dlg.querySelector('.lb-cap')!;
      let links: HTMLAnchorElement[] = [];
      let i = 0;
      const show = (n: number) => {
        i = (n + links.length) % links.length;
        im.src = links[i].href;
        im.alt = links[i].querySelector('img')?.alt ?? '';
        cap.textContent = links[i].dataset.caption ?? '';
        dlg.classList.toggle('single', links.length < 2);
      };
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
        if (!a) return;
        e.preventDefault();
        links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
        show(links.indexOf(a));
        dlg.showModal();
      });
      dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
      dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(i - 1));
      dlg.querySelector('.lb-next')!.addEventListener('click', () => show(i + 1));
      dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target === im) dlg.close(); });
      document.addEventListener('keydown', (e) => {
        if (!dlg.open) return;
        if (e.key === 'ArrowRight') show(i + 1);
        if (e.key === 'ArrowLeft') show(i - 1);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; justify-content: space-between; align-items: center; height: 64px; gap: 16px; }
  .brand { text-decoration: none; display: flex; gap: 10px; align-items: center; font-size: 15px; white-space: nowrap; color: var(--fg); }
  .logo { width: 22px; height: 22px; flex: none; }
  nav { display: flex; gap: clamp(14px, 2.5vw, 28px); font-size: 15px; align-items: center; }
  nav a { text-decoration: none; color: var(--muted); font-weight: 500; }
  nav a:hover, nav a[aria-current='page'] { color: var(--fg); }
  .lang { border: 1px solid var(--line); padding: 3px 9px; border-radius: 999px; font-size: 13px; }
  @media (max-width: 720px) {
    .hide-sm { display: none; }
  }

  .site-footer { border-top: 1px solid var(--line); padding: 40px 0 56px; font-size: 15px; }
  .foot { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .links { display: flex; gap: 24px; flex-wrap: wrap; align-items: center; }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; }

  dialog {
    border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh;
    width: 100vw; height: 100vh; display: none;
  }
  dialog[open] { display: grid; place-items: center; }
  dialog::backdrop { background: rgba(10, 10, 10, 0.92); }
  dialog img { max-width: 94vw; max-height: 86vh; width: auto; border-radius: 6px; cursor: zoom-out; }
  .lb-cap { position: fixed; bottom: 16px; left: 0; right: 0; text-align: center; color: #ccc; font-size: 14px; margin: 0; }
  .lb-close, .lb-nav {
    position: fixed; background: rgba(255,255,255,.12); color: #fff; border: 0; cursor: pointer;
    width: 44px; height: 44px; border-radius: 999px; font-size: 26px; line-height: 1;
  }
  .lb-close { top: 16px; right: 16px; }
  .lb-prev { left: 16px; top: 50%; }
  .lb-next { right: 16px; top: 50%; }
  dialog.single .lb-nav { display: none; }
</style>
