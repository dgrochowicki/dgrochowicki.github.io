---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Figure from '../components/Figure.astro';
import Contact from '../components/Contact.astro';
import { cases, tidioIntro } from '../data/cases';
import { projects, categories, type Category } from '../data/projects';
import { stats } from '../data/about';
import { ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const ti = tidioIntro[lang];
const earlier = projects.filter((p) => p.category !== 'lab');
const side = projects.filter((p) => p.category === 'lab');
const SHOW = 6;
const cats = (Object.keys(categories) as Category[]).filter((c) => earlier.some((p) => p.category === c));
---
<Base lang={lang} title="Portfolio" alt="portfolio" active="portfolio">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Portfolio</p>
      <h1 class="title">{ti.title}</h1>
      <div class="tidio">
        <div>
          {ti.text.map((p) => <p>{p}</p>)}
          <ul class="mini-stats">
            {stats[lang].slice(1, 3).map((s) => <li><strong>{s.value}</strong> <span class="muted">{s.label}</span></li>)}
          </ul>
        </div>
      </div>

      <h2 class="sub">{t.caseStudies}</h2>
      <div class="grid2">{cases.map((c, idx) => <CaseCard item={c} lang={lang} index={idx} />)}</div>

      <h2 class="sub">{lang === 'pl' ? 'Obszary, przy których pracowałem' : 'Product areas I worked on'}</h2>
      <ul class="areas">
        {ti.areas.map((a) => <li><strong>{a.name}</strong><span class="muted">{a.text}</span></li>)}
      </ul>
      <div class="gallery">
        {['tidio/overview-1', 'tidio/overview-3', 'tidio/areas-2', 'tidio/lyro-2', 'tidio/lyro-3', 'tidio/areas-3'].map((s) => (
          <Figure src={s} sizes="(max-width: 860px) 100vw, 600px" alt="Tidio UI" />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="title other">{t.otherProjects}</h2>
          <p class="muted">{t.otherProjectsLead}</p>
        </div>
        <div class="filters" role="group">
          <button class="tag active" data-filter="all">{t.all}</button>
          {cats.map((c) => <button class="tag" data-filter={c}>{categories[c][lang]}</button>)}
        </div>
      </div>
      <div class="grid3 projects collapsed">
        {earlier.map((p, n) => <div class:list={['pitem', { extra: n >= SHOW }]} data-cat={p.category}><ProjectCard item={p} lang={lang} /></div>)}
      </div>
      {earlier.length > SHOW && (
        <div class="more"><button class="btn" type="button" data-more>{t.showMore} ({earlier.length - SHOW})</button></div>
      )}
    </div>
  </section>

  {side.length > 0 && (
    <section class="section" id="side-projects">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 class="title other">{t.sideProjects}</h2>
            <p class="muted">{t.sideProjectsLead}</p>
          </div>
        </div>
        <div class="grid3">{side.map((p) => <ProjectCard item={p} lang={lang} />)}</div>
      </div>
    </section>
  )}

  <Contact lang={lang} />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.projects .pitem');
  const grid = document.querySelector('.projects');
  const more = document.querySelector<HTMLElement>('[data-more]');
  const expand = () => { grid?.classList.remove('collapsed'); more?.parentElement?.remove(); };
  more?.addEventListener('click', expand);
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      expand();
      buttons.forEach((x) => x.classList.toggle('active', x === b));
      cards.forEach((c) => (c.hidden = b.dataset.filter !== 'all' && c.dataset.cat !== b.dataset.filter));
    }),
  );
</script>

<style>
  .title { font-size: clamp(30px, 4.4vw, 48px); margin: 12px 0 40px; letter-spacing: -0.02em; }
  .title.other { margin: 0 0 8px; }
  .tidio { max-width: 52em; }
  .tidio p { font-size: 18px; }
  .mini-stats { list-style: none; margin-top: 28px; display: flex; flex-direction: column; gap: 8px; }
  .mini-stats strong { display: inline-block; min-width: 4.2em; font-weight: 600; }

  .sub { font-size: clamp(22px, 2.6vw, 28px); margin: clamp(56px, 8vw, 96px) 0 28px; }
  .grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 24px; }
  @media (max-width: 860px) { .grid2, .grid3 { grid-template-columns: 1fr; } }
  @media (min-width: 861px) and (max-width: 1080px) { .grid3 { grid-template-columns: 1fr 1fr; } }

  .areas { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-bottom: 48px; }
  .areas li { display: flex; flex-direction: column; gap: 6px; border-top: 1px solid var(--line); padding-top: 14px; font-size: 15px; }
  /* Ostatni obszar (Design system) na całą szerokość */
  .areas li:last-child { grid-column: 1 / -1; }
  .areas li:last-child span { max-width: 52em; }
  .areas strong { font-weight: 600; }
  @media (max-width: 860px) { .areas { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .areas { grid-template-columns: 1fr; } }
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 860px) { .gallery { grid-template-columns: 1fr; } }

  .projects.collapsed .extra { display: none; }
  .pitem[hidden] { display: none; }
  .more { display: flex; justify-content: center; margin-top: 40px; }
  .more .btn { background: transparent; color: var(--fg); font-family: inherit; cursor: pointer; }
  .more .btn:hover { background: var(--fg); color: var(--bg); }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .filters button { border: 1px solid transparent; cursor: pointer; font: inherit; font-size: 14px; color: var(--fg); }
  .filters button.active { background: var(--fg); color: var(--bg); }
</style>
