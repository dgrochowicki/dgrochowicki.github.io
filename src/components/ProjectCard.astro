---
import { Image } from 'astro:assets';
import { folder } from '../lib/images';
import { href, type Lang } from '../lib/i18n';
import { categories, type Project } from '../data/projects';

interface Props { item: Project; lang: Lang }
const { item, lang } = Astro.props;
const cover = folder(`projects/${item.slug}`)[0];
---
<a class="pcard" href={href(`portfolio/${item.slug}`, lang)} data-cat={item.category}>
  <div class="thumb">
    {cover && <Image src={cover} alt="" widths={[400, 700, 1000]} sizes="(max-width: 760px) 100vw, 400px" />}
  </div>
  <div class="meta">
    <h3>{item.title}</h3>
    <span class="muted">{categories[item.category][lang]}</span>
  </div>
  <p class="muted">{item.content[lang].summary}</p>
</a>

<style>
  .pcard { text-decoration: none; display: flex; flex-direction: column; gap: 10px; }
  .thumb { aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: var(--bg-soft); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .pcard:hover .thumb :global(img) { transform: scale(1.03); }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 4px; }
  .meta h3 { font-size: 17px; }
  .meta span { font-size: 13px; white-space: nowrap; }
  p { font-size: 15px; margin: 0; }
  .pcard[hidden] { display: none; }
</style>
