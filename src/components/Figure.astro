---
import { Image, getImage } from 'astro:assets';
import { img } from '../lib/images';

interface Props { src: string; caption?: string; alt?: string; sizes?: string; eager?: boolean; frame?: boolean }
const { src, caption, alt, sizes = '(max-width: 1248px) 100vw, 1200px', eager = false, frame = true } = Astro.props;
const meta = img(src);
const full = await getImage({ src: meta, width: Math.min(meta.width, 2400), format: 'webp' });
---
<figure class:list={['fig', { frame }]}>
  <a href={full.src} data-lightbox data-caption={caption ?? ''}>
    <Image
      src={meta}
      alt={alt ?? caption ?? ''}
      widths={[480, 800, 1200, 1600, 2400].filter((w) => w <= meta.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
    />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 0; }
  .fig a { display: block; cursor: zoom-in; }
  .frame a { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: var(--bg-soft); }
  .fig img { width: 100%; transition: transform .3s; }
  .fig a:hover img { transform: scale(1.01); }
  figcaption { font-size: 14px; color: var(--muted); margin-top: 10px; }
</style>
