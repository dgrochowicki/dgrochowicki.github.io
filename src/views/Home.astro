---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import EssayCard from '../components/EssayCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import { intro, stats, principles } from '../data/about';
import { cases } from '../data/cases';
import { projects } from '../data/projects';
import { href, asset, ui, type Lang } from '../lib/i18n';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const i = intro[lang];
const featured = ['coresender', 'child-reward', 'trading'].map((s) => projects.find((p) => p.slug === s)!);
---
<Base lang={lang} alt="" description={i.lead}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Product Designer · UX/UI · Szczecin</p>
      <h1>{i.hero.split('\n').map((line, n) => <>{n > 0 && <br />}{line}</>)}</h1>
      <p class="lead">{i.lead}</p>
      <div class="btns">
        <a class="btn primary" href={href('portfolio', lang)}>{t.seeCases}</a>
        <a class="btn" href={href(lang === 'pl' ? 'o-mnie' : 'about', lang)}>{t.navAbout}</a>
        <a class="btn" href={asset(site.cv[lang])} target="_blank" rel="noopener">{t.downloadCv}</a>
      </div>
      <ul class="stats">
        {stats[lang].map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t.caseStudiesLead}</p>
          <h2>{t.caseStudies}</h2>
        </div>
        <a class="text-link" href={href('portfolio', lang)}>{t.seeAll} →</a>
      </div>
      <div class="grid2">
        {cases.map((c, idx) => <CaseCard item={c} lang={lang} index={idx} />)}
      </div>
      <EssayCard lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>{t.howIWork}</h2></div>
      <ol class="principles">
        {principles[lang].map((p, idx) => (
          <li><span class="num">0{idx + 1}</span><h3>{p.title}</h3><p class="muted">{p.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>{t.otherProjects}</h2>
          <p class="muted">{t.otherProjectsLead}</p>
        </div>
        <a class="text-link" href={`${href('portfolio', lang)}#projects`}>{t.seeAll} →</a>
      </div>
      <div class="grid3">{featured.map((p) => <ProjectCard item={p} lang={lang} />)}</div>
    </div>
  </section>

  <Contact lang={lang} />
</Base>

<style>
  .hero { padding: clamp(64px, 12vw, 140px) 0 clamp(56px, 8vw, 96px); }
  .hero h1 { font-size: clamp(30px, 4.4vw, 52px); max-width: 17em; margin: 16px 0 24px; letter-spacing: -0.025em; }
  .lead { font-size: clamp(16px, 1.6vw, 18px); max-width: 40em; color: var(--muted); margin-bottom: 32px; }
  .stats { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: clamp(48px, 7vw, 80px); }
  .stats li { border-top: 1px solid var(--fg); padding-top: 14px; display: flex; flex-direction: column; gap: 4px; }
  @media (prefers-color-scheme: dark) { .stats li { border-top-color: #4b5058; } }
  .stats strong { font-size: clamp(26px, 3vw, 36px); font-weight: 500; letter-spacing: -0.02em; }
  .stats span { color: var(--muted); font-size: 14px; line-height: 1.4; }
  @media (max-width: 760px) { .stats { grid-template-columns: 1fr 1fr; gap: 28px 16px; } }

  .grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 24px; }
  @media (max-width: 860px) { .grid2, .grid3 { grid-template-columns: 1fr; } }

  .principles { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .principles .num { display: inline-block; background: var(--accent); color: var(--accent-fg); font-weight: 600; font-size: 13px; padding: 2px 8px; border-radius: 6px; margin-bottom: 14px; }
  .principles h3 { font-size: 19px; margin-bottom: 10px; }
  @media (max-width: 860px) { .principles { grid-template-columns: 1fr; gap: 28px; } }
</style>
