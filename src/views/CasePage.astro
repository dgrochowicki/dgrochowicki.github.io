---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { cases, type CaseStudy } from '../data/cases';
import { essay } from '../data/essay';
import { href, ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang; item: CaseStudy }
const { lang, item } = Astro.props;
const t = ui[lang];
const c = item.content[lang];
const idx = cases.findIndex((x) => x.slug === item.slug);
const next = cases[(idx + 1) % cases.length];
const lessonIdx = essay.content[lang].lessons.findIndex((l) => l.cases?.includes(item.slug));
const relLesson = lessonIdx >= 0 ? essay.content[lang].lessons[lessonIdx] : undefined;
const imgSizes = (n: number) => (n > 1 ? '(max-width: 860px) 100vw, 600px' : '(max-width: 1248px) 100vw, 1200px');
---
<Base lang={lang} title={c.title} alt={`portfolio/${item.slug}`} active="portfolio" description={c.summary}>
  <article>
    <header class="wrap head">
      <a class="back text-link" href={href('portfolio', lang)}>← {t.back}</a>
      <p class="eyebrow">{c.label}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.summary}</p>
    </header>

    <div class="wrap">
      <dl class:list={['meta', { 'no-year': !c.year }]}>
        <div><dt>{t.myRole}</dt><dd>{c.role}</dd></div>
        <div><dt>{t.scope}</dt><dd><ul>{c.scope.map((x) => <li>{x}</li>)}</ul></dd></div>
        <div><dt>{t.team}</dt><dd>{c.team.map((x, i) => <><span class="nowrap">{x}</span>{i < c.team.length - 1 && ', '}</>)}</dd></div>
        {c.year && <div><dt>{t.year}</dt><dd>{c.year}</dd></div>}
      </dl>
      <div class="cover"><Figure src={item.cover} eager frame={false} /></div>
    </div>

    {c.sections.map((s) => (
      <Fragment>
      {s.title === t.solution && (
        <div class="wrap imgs n2 process">
          {c.processImages.map((src, n) => <Figure src={src} caption={c.processCaptions[n]} sizes="(max-width: 860px) 100vw, 600px" />)}
        </div>
      )}
      <section class="wrap block">
        <div class="row">
          <h2 class="label">{s.title}</h2>
          <div class="content">
            {s.text?.map((p) => <p>{p}</p>)}
            {s.list && <ul class="bullets">{s.list.map((l) => <li>{l}</li>)}</ul>}
            {s.steps && (
              <ol class="steps">
                {s.steps.map((st, n) => (
                  <li>
                    <span class="num">{n + 1}</span>
                    <div>
                      <h3>{st.title}</h3>
                      <p>{st.text}</p>
                      {st.rejected && <p class="rejected">{lang === 'pl' ? 'Odrzucone' : 'Rejected'}: {st.rejected}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            )}
            {s.note && <p class="note">{s.note}</p>}
          </div>
        </div>

        {s.compare && (
          <div class="compare">
            {(['before', 'after'] as const).map((k) => (
              <div class:list={['col', k]}>
                <span class="badge">{t[k]}</span>
                <ul class="bullets">{s.compare![k].list.map((l) => <li>{l}</li>)}</ul>
                {s.compare![k].images.map((src) => <Figure src={src} caption={t[k]} sizes="(max-width: 860px) 100vw, 600px" />)}
              </div>
            ))}
          </div>
        )}

        {s.images && (
          <div class:list={['imgs', `n${s.images.length}`]}>
            {s.images.map((src, n) => <Figure src={src} caption={s.captions?.[n]} sizes={imgSizes(s.images!.length)} />)}
          </div>
        )}

        {s.title === t.solution && (
          <div class="effect-row">
            <div class="effect">
              <p class="effect-label">{t.effect}</p>
              <p class="effect-text">{c.effect}</p>
            </div>
          </div>
        )}
      </section>
      </Fragment>
    ))}

    <section class="wrap">
      <div class="lesson">
        <p class="lesson-label">{t.lesson}</p>
        <p class="lesson-text">{c.lesson}</p>
        {relLesson && (
          <a class="essay-link" href={`${href(`portfolio/${essay.slug}`, lang)}#lekcja-${lessonIdx + 1}`}>
            <span class="muted">{t.moreInEssay}</span>
            <span>{essay.content[lang].title}</span>
            <span class="essay-lesson">{t.lessonN} {lessonIdx + 1}: {relLesson.title} <span class="arrow">→</span></span>
          </a>
        )}
      </div>
    </section>

    <nav class="wrap next">
      <a href={href(`portfolio/${next.slug}`, lang)}>
        <strong>{t.next} case study <span class="arrow">→</span></strong>
        <span class="muted">{next.content[lang].title}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .head { padding-top: clamp(40px, 7vw, 80px); padding-bottom: 40px; }
  .back { display: inline-block; margin-bottom: 40px; font-size: 15px; }
  .head h1 { font-size: clamp(32px, 5vw, 56px); max-width: 16em; margin: 14px 0 20px; letter-spacing: -0.025em; }
  .lead { font-size: clamp(18px, 2vw, 21px); color: var(--muted); max-width: 38em; }
  /* Rząd meta: Rola | Zakres | Zespół | Rok. Nagłówek kolumny z linią pod spodem */
  .meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin: 24px 0 clamp(40px, 6vw, 64px); }
  .meta.no-year { grid-template-columns: repeat(3, 1fr); }
  .meta dt { font-size: 15px; font-weight: 600; padding-bottom: 12px; border-bottom: 1px solid var(--fg); margin-bottom: 14px; }
  .meta dd { margin: 0; font-size: 15px; }
  .nowrap { white-space: nowrap; }
  .meta ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  @media (max-width: 760px) { .meta, .meta.no-year { grid-template-columns: 1fr 1fr; gap: 28px 20px; } }

  /* Cover: zrzut na tle z gradientem, przycięty od dołu */
  .cover { background: linear-gradient(180deg, #8f9ab4 0%, #e6e8ed 100%); border-radius: var(--radius); padding: clamp(20px, 5vw, 64px) clamp(16px, 5vw, 60px) 0; max-height: 760px; overflow: hidden; }
  .cover :global(img) { display: block; border-radius: 8px 8px 0 0; box-shadow: 0 8px 32px rgba(20, 30, 60, .18); }
  @media (prefers-color-scheme: dark) { .cover { background: linear-gradient(180deg, #3a4258 0%, #1c1d1f 100%); } }

  .block { padding-top: clamp(40px, 6vw, 72px); }
  .block .row { border-top: 1px solid var(--line); }
  .block h2.label { font-size: 15px; font-weight: 600; line-height: 1.6; color: var(--fg); }
  .content { max-width: var(--text); }
  .bullets { padding-left: 1.1em; display: flex; flex-direction: column; gap: 6px; }
  .content .bullets { margin-top: 4px; }
  .steps { list-style: none; display: flex; flex-direction: column; gap: 24px; }
  .steps li { display: grid; grid-template-columns: 32px 1fr; gap: 14px; }
  .steps .num { width: 28px; height: 28px; border-radius: 8px; background: var(--accent); color: var(--accent-fg); display: grid; place-items: center; font-weight: 600; font-size: 14px; }
  .steps h3 { font-size: 17px; margin: 2px 0 6px; }
  .steps p { margin: 0; }
  .rejected { color: var(--muted); font-size: 15px; margin-top: 6px !important; text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--muted) 60%, transparent); }
  .note { margin-top: 24px; padding: 14px 18px; border-left: 3px solid var(--muted); background: var(--bg-soft); border-radius: 0 8px 8px 0; font-size: 15px; }

  .imgs { display: grid; gap: 24px; margin-top: 8px; }
  .imgs.n2 { grid-template-columns: 1fr 1fr; }
  .imgs.n3 { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 860px) { .imgs.n2, .imgs.n3 { grid-template-columns: 1fr; } }
  /* Proces: zawsze 2 w rzędzie, mniejsze odstępy */
  .imgs.n2.process { gap: 16px; margin-top: 32px; }
  /* Efekt: szary blok w kolumnie treści, pogrubiony tekst w rozmiarze body */
  .effect-row { display: grid; grid-template-columns: 220px 1fr; column-gap: 48px; margin: 8px 0 0; }
  .effect { grid-column: 2; background: var(--bg-soft); border-radius: var(--radius); padding: clamp(20px, 3vw, 32px) clamp(20px, 3vw, 40px); }
  .effect-label { color: var(--muted); font-size: 15px; margin: 0 0 6px; }
  .effect-text { font-weight: 600; margin: 0; }
  @media (max-width: 760px) { .effect-row { grid-template-columns: 1fr; } .effect { grid-column: 1; } }
  .process :global(figcaption) { font-size: 13px; }

  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .compare .col { border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; display: flex; flex-direction: column; gap: 18px; }
  .compare .after { border-color: color-mix(in srgb, var(--fg) 35%, transparent); }
  .badge { align-self: start; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; padding: 3px 10px; border-radius: 999px; background: var(--bg-soft); }
  .after .badge { background: var(--accent); color: var(--accent-fg); }
  .compare .bullets { font-size: 15px; }
  .compare :global(figcaption) { display: none; }
  @media (max-width: 860px) { .compare { grid-template-columns: 1fr; } }

  /* Wniosek: bez tła, duży nagłówek, link do eseju w kolorze linku ze strzałką */
  .lesson { margin-top: clamp(56px, 8vw, 96px); padding-top: clamp(32px, 4vw, 48px); border-top: 1px solid var(--line); }
  .lesson-label { font-size: 15px; font-weight: 600; margin: 0 0 12px; }
  .lesson-text { font-size: clamp(26px, 3.4vw, 40px); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; max-width: 24em; margin: 0; }
  .essay-link { display: inline-flex; flex-direction: column; gap: 2px; margin-top: 24px; text-decoration: none; font-size: clamp(16px, 1.6vw, 18px); color: var(--link); font-weight: 500; }
  .essay-link .muted { font-size: 13px; font-weight: 400; margin-bottom: 6px; }
  .essay-link .arrow { display: inline-block; transition: transform .25s ease; }
  .essay-link:hover .arrow { transform: translateX(6px); }
  .next { padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(56px, 8vw, 96px); }
  .next a { display: flex; flex-direction: column; gap: 8px; text-decoration: none; border: 1px solid color-mix(in srgb, var(--fg) 30%, transparent); border-radius: var(--radius); padding: clamp(24px, 3vw, 40px); transition: .2s; }
  .next a:hover { border-color: color-mix(in srgb, var(--fg) 45%, transparent); }
  .next strong { font-size: clamp(24px, 3vw, 36px); font-weight: 400; letter-spacing: -0.015em; }
  .next .muted { font-size: 14px; }
  .next .arrow { display: inline-block; transition: transform .25s ease; }
  .next a:hover .arrow { transform: translateX(6px); }
  @media (prefers-reduced-motion: reduce) { .next .arrow, .essay-link .arrow { transition: none; } }
</style>
