---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import HandoffDiagram from '../components/HandoffDiagram.astro';
import { essay, readingMinutes } from '../data/essay';
import { cases } from '../data/cases';
import { href, ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = essay.content[lang];
const first = cases[0];
const imgSizes = (n: number) => (n > 1 ? '(max-width: 860px) 100vw, 600px' : '(max-width: 1248px) 100vw, 1200px');
---
<!-- Układ i style jak w CasePage.astro: nagłówek, sekcje .row (etykieta | treść), obrazy pod sekcją, ciemny blok na końcu -->
<Base lang={lang} title={c.title} alt={`portfolio/${essay.slug}`} active="portfolio" description={c.summary}>
  <article>
    <header class="wrap head">
      <a class="back text-link" href={href('portfolio', lang)}>← {t.back}</a>
      <p class="eyebrow">{c.label} · {t.readTime(readingMinutes(lang))}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.intro}</p>
      <ol class="toc">
        {c.lessons.map((l, n) => <li><a href={`#lekcja-${n + 1}`}>{l.title}</a></li>)}
      </ol>
    </header>

    {c.lessons.map((l, n) => (
      <section class="wrap block" id={`lekcja-${n + 1}`}>
        <div class="row">
          <h2 class="label">{t.lessonN} {n + 1}</h2>
          <div class="content">
            <h3>{l.title}</h3>
            <h4 class="eyebrow">{t.situation}</h4>
            <p>{l.situation}</p>
            <h4 class="eyebrow">{t.decision}</h4>
            {l.decision.map((p) => <p>{p}</p>)}
            <p class="note"><strong>{t.why}:</strong> {l.why}</p>
            {l.cases && (
              <ul class="related">
                {l.cases.map((slug) => {
                  const cs = cases.find((x) => x.slug === slug)!;
                  return <li><a class="text-link" href={href(`portfolio/${slug}`, lang)}>{t.moreInCase}: {cs.content[lang].title} →</a></li>;
                })}
              </ul>
            )}
          </div>
        </div>

        {l.diagram === 'handoff' && <HandoffDiagram lang={lang} />}
        {l.images && (
          <div class:list={['imgs', `n${l.images.length}`]}>
            {l.images.map((src, k) => <Figure src={src} caption={l.captions?.[k]} sizes={imgSizes(l.images!.length)} />)}
          </div>
        )}
      </section>
    ))}

    <section class="wrap">
      <div class="lesson">
        <p class="eyebrow">{c.closingTitle}</p>
        {c.closing.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <nav class="wrap next">
      <a href={href(`portfolio/${first.slug}`, lang)}>
        <span class="eyebrow">Case study 01</span>
        <strong>{first.content[lang].title} →</strong>
      </a>
    </nav>
  </article>
</Base>

<style>
  /* Te same wartości co w CasePage.astro */
  .head { padding-top: clamp(40px, 7vw, 80px); padding-bottom: 40px; }
  .back { display: inline-block; margin-bottom: 40px; font-size: 15px; }
  .head h1 { font-size: clamp(32px, 5vw, 56px); max-width: 16em; margin: 14px 0 20px; letter-spacing: -0.025em; }
  .lead { font-size: clamp(18px, 2vw, 21px); color: var(--muted); max-width: 38em; }
  .toc { margin-top: 24px; padding-left: 1.3em; display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
  .toc li::marker { color: var(--muted); }
  .toc a { text-decoration: none; }
  .toc a:hover { text-decoration: underline; }

  .block { padding-top: clamp(40px, 6vw, 72px); scroll-margin-top: 24px; }
  .block .row { border-top: 1px solid var(--line); }
  .block h2.label { font-size: 15px; font-weight: 500; line-height: 1.6; }
  .content { max-width: var(--text); }
  .content h3 { font-size: 20px; margin-bottom: 16px; }
  .content h4.eyebrow { margin: 18px 0 4px; }
  .content h3 + h4.eyebrow { margin-top: 0; }
  .content p { margin: 0 0 8px; }
  .note { margin-top: 24px !important; padding: 14px 18px; border-left: 3px solid var(--muted); background: var(--bg-soft); border-radius: 0 8px 8px 0; font-size: 15px; }
  .related { list-style: none; margin-top: 16px; display: flex; flex-direction: column; gap: 6px; font-size: 15px; }

  .imgs { display: grid; gap: 24px; margin-top: 8px; }
  .imgs.n2 { grid-template-columns: 1fr 1fr; }
  @media (max-width: 860px) { .imgs.n2 { grid-template-columns: 1fr; } }

  .lesson { margin-top: clamp(56px, 8vw, 96px); background: var(--fg); color: var(--bg); border-radius: var(--radius); padding: clamp(28px, 5vw, 56px); }
  .lesson .eyebrow { color: var(--accent); margin-bottom: 12px; }
  .lesson p:not(.eyebrow) { font-size: clamp(17px, 1.8vw, 20px); line-height: 1.5; max-width: 38em; margin: 0 0 12px; }
  .lesson p:last-child { margin-bottom: 0; }
  @media (prefers-color-scheme: dark) { .lesson { background: var(--bg-soft); color: var(--fg); border: 1px solid var(--line); } }

  .next { padding-top: 40px; padding-bottom: clamp(56px, 8vw, 96px); }
  .next a { display: flex; flex-direction: column; gap: 6px; text-decoration: none; border-top: 1px solid var(--line); padding-top: 28px; }
  .next strong { font-size: clamp(20px, 2.6vw, 28px); font-weight: 600; }
  .next a:hover strong { text-decoration: underline; }
</style>
