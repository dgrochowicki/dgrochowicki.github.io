---
import { site } from '../data/site';
import { asset, ui, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const t = ui[Astro.props.lang];
---
<section class="section contact">
  <div class="wrap">
    <h2>{t.contactTitle}</h2>
    <p class="muted">{t.contactText}</p>
    <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="btns">
      <a class="btn primary" href={`mailto:${site.email}`}>{t.write}</a>
      <a class="btn" href={asset(site.cv)} target="_blank" rel="noopener">{t.downloadCv} ↓</a>
      {site.linkedin && <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
    </div>
  </div>
</section>
<style>
  .contact h2 { font-size: clamp(28px, 4vw, 44px); margin-bottom: 12px; }
  .mail { display: inline-block; font-size: clamp(20px, 3vw, 28px); margin: 12px 0 28px; text-decoration-color: var(--accent); text-decoration-thickness: 4px; text-underline-offset: 6px; }
</style>
