---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Figure from '../components/Figure.astro';
import Contact from '../components/Contact.astro';
import { cases, tidioIntro } from '../data/cases';
import { projects, categories, type Category } from '../data/projects';
import { stats } from '../data/about';
import { ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const ti = tidioIntro[lang];
const cats = Object.keys(categories) as Category[];
---
<Base lang={lang} title="Portfolio" alt="portfolio" active="portfolio">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Portfolio</p>
      <h1 class="title">{ti.title}</h1>
      <div class="tidio">
        <div>
          {ti.text.map((p) => <p>{p}</p>)}
          <ul class="mini-stats">
            {stats[lang].slice(1, 3).map((s) => <li><strong>{s.value}</strong> <span class="muted">{s.label}</span></li>)}
          </ul>
        </div>
        <Figure src="tidio/hero" frame={false} eager sizes="(max-width: 860px) 100vw, 560px" alt="Tidio Lyro AI Agent" />
      </div>

      <h2 class="sub">{t.caseStudies}</h2>
      <div class="grid2">{cases.map((c, idx) => <CaseCard item={c} lang={lang} index={idx} />)}</div>

      <h2 class="sub">{lang === 'pl' ? 'Obszary, przy których pracowałem' : 'Product areas I worked on'}</h2>
      <ul class="areas">
        {ti.areas.map((a) => <li><strong>{a.name}</strong><span class="muted">{a.text}</span></li>)}
      </ul>
      <div class="gallery">
        {['tidio/overview-1', 'tidio/overview-3', 'tidio/areas-2', 'tidio/lyro-2', 'tidio/lyro-3', 'tidio/areas-3'].map((s) => (
          <Figure src={s} sizes="(max-width: 860px) 100vw, 600px" alt="Tidio UI" />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="title other">{t.otherProjects}</h2>
          <p class="muted">{t.otherProjectsLead}</p>
        </div>
        <div class="filters" role="group">
          <button class="tag active" data-filter="all">{t.all}</button>
          {cats.map((c) => <button class="tag" data-filter={c}>{categories[c][lang]}</button>)}
        </div>
      </div>
      <div class="grid3 projects">{projects.map((p) => <ProjectCard item={p} lang={lang} />)}</div>
    </div>
  </section>

  <Contact lang={lang} />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.projects [data-cat]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.classList.toggle('active', x === b));
      cards.forEach((c) => (c.hidden = b.dataset.filter !== 'all' && c.dataset.cat !== b.dataset.filter));
    }),
  );
</script>

<style>
  .title { font-size: clamp(30px, 4.4vw, 48px); margin: 12px 0 40px; letter-spacing: -0.02em; }
  .title.other { margin: 0 0 8px; }
  .tidio { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .tidio p { max-width: var(--text); }
  .tidio :global(.fig img) { border-radius: var(--radius); }
  .mini-stats { list-style: none; margin-top: 28px; display: flex; flex-direction: column; gap: 8px; }
  .mini-stats strong { display: inline-block; min-width: 4.2em; font-weight: 600; }
  @media (max-width: 860px) { .tidio { grid-template-columns: 1fr; } }

  .sub { font-size: clamp(22px, 2.6vw, 28px); margin: clamp(56px, 8vw, 96px) 0 28px; }
  .grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 24px; }
  @media (max-width: 860px) { .grid2, .grid3 { grid-template-columns: 1fr; } }
  @media (min-width: 861px) and (max-width: 1080px) { .grid3 { grid-template-columns: 1fr 1fr; } }

  .areas { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px 32px; margin-bottom: 40px; }
  .areas li { display: flex; flex-direction: column; border-top: 1px solid var(--line); padding-top: 12px; font-size: 15px; }
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 860px) { .gallery { grid-template-columns: 1fr; } }

  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .filters button { border: 1px solid transparent; cursor: pointer; font: inherit; font-size: 14px; color: var(--fg); }
  .filters button.active { background: var(--fg); color: var(--bg); }
</style>
