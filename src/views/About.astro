---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { intro, experience, skills, education, awards, volunteering, languages } from '../data/about';
import { img } from '../lib/images';
import { site } from '../data/site';
import { asset, ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const pl = lang === 'pl';
const L = {
  about: pl ? 'O mnie' : 'About',
  exp: pl ? 'Doświadczenie' : 'Experience',
  skills: pl ? 'Umiejętności' : 'Skills',
  comp: pl ? 'Kompetencje' : 'Competencies',
  tools: pl ? 'Narzędzia i dodatkowe umiejętności' : 'Tools & other skills',
  edu: pl ? 'Edukacja' : 'Education',
  lang: pl ? 'Języki' : 'Languages',
  awards: pl ? 'Nagrody' : 'Awards',
  other: pl ? 'Wolontariat' : 'Volunteering',
};
---
<Base lang={lang} title={L.about} alt={pl ? 'about' : 'o-mnie'} active="about" description={intro[lang].lead}>
  <section class="section top">
    <div class="wrap intro">
      <div>
        <p class="eyebrow">{L.about}</p>
        <h1>{site.name}</h1>
        <p class="role">{t.role}</p>
        {intro[lang].bio.map((p) => <p>{p}</p>)}
        <div class="btns"><a class="btn primary" href={asset(site.cv)} target="_blank" rel="noopener">{t.downloadCv} ↓</a></div>
      </div>
      <div class="photo">
        <Image src={img('about/photo')} alt={site.name} widths={[400, 700]} sizes="(max-width: 860px) 60vw, 380px" loading="eager" />
      </div>
    </div>
  </section>

  <section class="wrap cv">
    <div class="row">
      <div class="label">{L.exp}</div>
      <ol class="jobs">
        {experience[lang].map((j) => (
          <li class="job">
            <div class="job-body">
              <h3>{j.company}</h3>
              <p class="muted job-role">{j.role}</p>
              {j.text && <p>{j.text}</p>}
              {j.bullets && <ul class="bullets">{j.bullets.map((b) => <li>{b}</li>)}</ul>}
            </div>
            <span class="muted job-years">{j.years}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="row">
      <div class="label">{L.skills}</div>
      <div class="skills">
        <div><h3>{L.comp}</h3><ul class="bullets plain">{skills[lang].competencies.map((s) => <li>{s}</li>)}</ul></div>
        <div><h3>{L.tools}</h3><ul class="bullets plain">{skills[lang].tools.map((s) => <li>{s}</li>)}</ul></div>
      </div>
    </div>

    <div class="row">
      <div class="label">{L.edu}</div>
      <ul class="entries">
        {education[lang].map((e) => <li class="job"><div class="job-body"><h3>{e.title}</h3><p class="muted">{e.sub}</p></div><span class="muted job-years">{e.years}</span></li>)}
      </ul>
    </div>

    <div class="row">
      <div class="label">{L.awards}</div>
      <ul class="entries">
        {awards[lang].map((e) => <li class="job"><div class="job-body"><h3>{e.title}</h3><p class="muted">{e.sub}</p></div><span class="muted job-years">{e.years}</span></li>)}
      </ul>
    </div>

    <div class="row">
      <div class="label">{L.lang}</div>
      <ul class="bullets plain">{languages[lang].map((s) => <li>{s}</li>)}</ul>
    </div>

    <div class="row">
      <div class="label">{L.other}</div>
      <ul class="bullets plain">{volunteering[lang].map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <Contact lang={lang} />
</Base>

<style>
  .top { padding-bottom: 72px; }
  .intro { display: grid; grid-template-columns: 1fr 340px; gap: clamp(32px, 6vw, 96px); align-items: stretch; }
  .intro h1 { font-size: clamp(34px, 5vw, 56px); margin-top: 12px; letter-spacing: -0.025em; }
  .role { color: var(--muted); font-size: 20px; margin: 6px 0 28px; }
  .intro p:not(.eyebrow):not(.role) { max-width: var(--text); }
  .intro .btns { margin-top: 28px; }
  /* Zdjęcie rozciąga się na wysokość kolumny z tekstem (do przycisku CV) */
  .photo { position: relative; border-radius: var(--radius); overflow: hidden; background: var(--bg-soft); }
  .photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  @media (max-width: 860px) { .intro { grid-template-columns: 1fr; } .photo { max-width: 320px; aspect-ratio: 4 / 5; order: -1; } }

  .cv { padding-bottom: 40px; }
  .jobs { list-style: none; display: flex; flex-direction: column; gap: 64px; max-width: 920px; }
  .job { display: grid; grid-template-columns: minmax(0, 1fr) 150px; gap: 32px; align-items: baseline; }
  .job-body { max-width: 720px; }
  .job-body h3 { font-size: 18px; }
  .job-years { white-space: nowrap; font-size: 15px; text-align: right; }
  @media (max-width: 760px) {
    .jobs { gap: 44px; }
    .job { grid-template-columns: 1fr; gap: 2px; }
    .job-years { order: -1; text-align: left; }
  }
  .job-role { margin: 2px 0 10px; }
  .bullets { padding-left: 1.1em; display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }
  .bullets.plain { margin: 0; }
  .skills { display: flex; flex-direction: column; gap: 28px; }
  .skills h3 { font-size: 16px; margin-bottom: 12px; }
  .entries { list-style: none; display: flex; flex-direction: column; gap: 28px; max-width: 920px; }
  .entries p { margin: 4px 0 0; }
</style>
