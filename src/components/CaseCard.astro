---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import { href, ui, type Lang } from '../lib/i18n';
import type { CaseStudy } from '../data/cases';

interface Props { item: CaseStudy; lang: Lang; index: number }
const { item, lang, index } = Astro.props;
const c = item.content[lang];
---
<a class="card" href={href(`portfolio/${item.slug}`, lang)}>
  <div class="thumb">
    <Image src={img(item.cover)} alt="" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 600px" />
  </div>
  <div class="body">
    <span class="eyebrow">Case study {String(index + 1).padStart(2, '0')}</span>
    <h3>{c.title}</h3>
    <p class="muted">{c.summary}</p>
    <span class="text-link">{ui[lang].readCase} →</span>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; text-decoration: none; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: .2s; background: var(--bg); }
  .card:hover { border-color: var(--muted); transform: translateY(-2px); }
  /* Kafelek 16:9 + górny margines większy niż boczny: zrzut 16:9 zawsze lekko wchodzi pod dolną krawędź */
  .thumb { aspect-ratio: 16 / 9; overflow: hidden; background: var(--accent-bg); padding: 36px 20px 0; }
  /* Pełna szerokość zrzutu, przycinany jest tylko dół (ekran „wychodzi” poza kafelek) */
  .thumb :global(img) { display: block; width: 100%; height: auto; border-radius: 8px 8px 0 0; box-shadow: 0 6px 24px rgba(0,0,0,.08); }
  .body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .body h3 { font-size: 20px; }
  .body p { font-size: 15px; flex: 1; }
</style>
